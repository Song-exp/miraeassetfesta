# HyperCLOVA X — CLOVA Studio
#
# 인증 스킴: 신규(2025-01 이후) 단일 Bearer 토큰.
#   구버전 X-NCP-CLOVASTUDIO-API-KEY + APIGW 게이트웨이 키 2-키 방식은 지원 중단 예정입니다.
#   구 호스트 clovastudio.apigw.ntruss.com 도 마찬가지 — 쓰지 마세요.
#   확인: https://api.ncloud-docs.com/docs/ai-naver-clovastudio-summary (2026-08-14 확인)
#
# 발급: 콘솔 > All Services > AI Services > CLOVA Studio > API 키 > [테스트] 탭
#   - 앱 생성 불필요. 계정당 10개까지.
#   - 🔴 발급 팝업을 닫으면 키를 다시 볼 수 없습니다. 즉시 저장하세요.
#   - 서비스 API 키는 '서비스 앱' 등록 절차가 따로 필요합니다.
HYPERCLOVA_API_KEY=nv-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HYPERCLOVA_BASE_URL=https://clovastudio.stream.ntruss.com

# API Server Config
PORT=8000
HOST=0.0.0.0

# 에이전트 완성 전에는 0. /health 에 노출되어 더미 상태를 구분합니다.
AGENT_READY=0

# 배포 — Caddy 가 이 이름으로 Let's Encrypt 인증서를 발급받습니다.
# <NCP 공인 IP>.nip.io  (도메인 구매 불필요. nip.io 가 IP로 해석)
#   예) SITE_ADDRESS=223.130.145.7.nip.io
# 로컬에서 compose 를 돌릴 때는 :80 등 아무 값이나 넣어도 됩니다.
SITE_ADDRESS=

# ── 실험 운영 (평가와 무관 — 팀 내부용) ────────────────────────────────
# /reload : 온톨로지·KG 재생성 후 재기동 없이 판단 원천을 다시 읽습니다.
#           비어 있으면 엔드포인트가 404 로 잠깁니다. 반드시 채우고 쓰세요.
#   curl -X POST -H "X-Reload-Token: $RELOAD_TOKEN" https://<IP>.nip.io/reload
#   ⚠️ 워커별 캐시라 --workers 2 면 한 워커만 갱신됩니다. 확실히 하려면 restart.
RELOAD_TOKEN=

# /chat : 팀 실험용 웹 UI. 비어 있으면 /chat 자체가 404 입니다.
#   접속 → https://<IP>.nip.io/chat?t=<CHAT_TOKEN>
#   ⚠️ 이 토큰은 UI 접근만 막습니다. /answer 는 평가 계약상 열려 있습니다.
CHAT_TOKEN=

# 질의 로그 위치 (컨테이너 기준). compose 가 ./logs 로 마운트합니다.
API_LOG_DIR=/app/logs
