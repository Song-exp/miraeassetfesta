# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.local
.env.*.local

# 🔴 SSH 개인키 — 커밋하면 서버가 통째로 넘어갑니다. NCP 인증키는 재발급도 불가.
#    secrets/ 안에 두고, 확장자 규칙으로 한 번 더 막습니다.
secrets/
*.pem
*.key
*.ppk
id_rsa
id_ed25519

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Project specific caches
.pytest_cache/
.coverage
htmlcov/

# Database files
*.db
*.sqlite
*.sqlite3
data/*.db

# Raw data files — 원본 데이터는 절대 push 금지.
# data/ 는 로컬 산출물/캐시 전용입니다.
1.*/
1.금융상품/
data/
*.xlsx
*.xls
*.csv
*.parquet

# 🔴 예외 — 코드북은 산출물이다 (ONTOLOGY_BUILD_PLAN.md §2.2).
# 원본 데이터가 아니라 '코드 ↔ 이름' 매핑이며, .ttl·KG 생성기의 입력이므로 반드시 추적한다.
!ontology/codebooks/*.csv

# Jupyter — EDA 노트북은 커밋합니다 (2026-08-18 정책 변경).
#
# 이전 정책은 notebooks/*.ipynb 전체 무시였습니다. 이유는 ① git diff 가 안 읽혀 리뷰가 불가능
# ② 출력 셀에 데이터가 박힘 이었고, 둘 다 여전히 사실입니다. 그런데 판정 문서들이
# 노트북 셀을 **근거로 인용**하고 있어(conclusions §6.2 '⑥-D' · 값 사전 '셀 27~31')
# 인용 대상이 저장소에 없는 상태였습니다 — 다른 장비에서 pull 하면 관측을 재현할 수 없습니다.
# EDA 노트북은 산출물의 근거이므로 추적합니다.
#
# 🔴 개인 탐색·임시 노트북은 notebooks/scratch/ 에 두세요 (아래에서 무시됩니다).
# 🔴 저장소가 public 입니다. 출력 셀에 원본 전수 목록을 남기지 마세요 —
#    distinct 값 전량 출력은 ontology/enums/*.values.txt 와 같은 성격이라 커밋 대상이 아닙니다.
.ipynb_checkpoints/
notebooks/scratch/

# 프로파일러 산출물 — scripts/profile_table.py 로 언제든 재생성되므로 커밋하지 않습니다.
#   *.values.txt : distinct 값 목록 (사실상 원본 데이터 재출력, 총 10MB+)
#   *.auto.yaml  : 컬럼 프로파일. 탐지기를 고칠 때마다 전체가 바뀌어 diff 노이즈가 큽니다.
# 사람의 판단이 들어간 ontology/enums/<domain>.yaml 은 커밋 대상입니다.
ontology/enums/*.values.txt
ontology/enums/*.auto.yaml

# 도메인 이해용 원본 PDF — 원문 배포 금지 (요지는 docs/domain/*.md 로 정리됨)
docs/domain/*.pdf

# 실험 챗봇 로그 — 산출물이지 소스가 아니다 (오답은 eval/questions_*.jsonl 로 승격)
logs/

# 주최 배포본 압축해제 폴더 — data/ 로 옮겨 쓰는 임시 스테이징 (실물은 드라이브 공유)
mirae_data_*/

# 선행연구 PDF — arXiv 에서 재다운로드 가능 (docs/research/notes/INDEX.md 에 ID)
docs/research/papers/
