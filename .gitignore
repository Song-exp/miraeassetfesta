# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.local
.env.*.local

# 🔴 SSH 개인키 — 커밋하면 서버가 통째로 넘어갑니다. NCP 인증키는 재발급도 불가.
#    secrets/ 안에 두고, 확장자 규칙으로 한 번 더 막습니다.
secrets/
*.pem
*.key
*.ppk
id_rsa
id_ed25519

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Project specific caches
.pytest_cache/
.coverage
htmlcov/

# Database files
*.db
*.sqlite
*.sqlite3
data/*.db

# Raw data files — 원본 데이터는 절대 push 금지.
# data/ 는 로컬 산출물/캐시 전용입니다.
1.*/
1.금융상품/
data/
*.xlsx
*.xls
*.csv
*.parquet

# Jupyter — 개인 탐색 노트북은 커밋하지 않습니다.
# .ipynb 는 git diff 가 안 읽혀 리뷰가 불가능하고, 출력 셀에 데이터가 박힙니다.
# 산출물은 docs/eda/*_notes.md 와 eval/*.jsonl 입니다. 템플릿만 공유합니다.
.ipynb_checkpoints/
notebooks/*.ipynb
!notebooks/eda_template.ipynb

# 프로파일러 산출물 — scripts/profile_table.py 로 언제든 재생성되므로 커밋하지 않습니다.
#   *.values.txt : distinct 값 목록 (사실상 원본 데이터 재출력, 총 10MB+)
#   *.auto.yaml  : 컬럼 프로파일. 탐지기를 고칠 때마다 전체가 바뀌어 diff 노이즈가 큽니다.
# 사람의 판단이 들어간 ontology/enums/<domain>.yaml 은 커밋 대상입니다.
ontology/enums/*.values.txt
ontology/enums/*.auto.yaml
