# ── 상품 클래스 계층 ──
# 축이 둘이다. 섞으면 안 된다:
#   (a) 테이블 클래스 — 데이터가 어느 마스터에서 왔나 (fp:DomesticETF … — 각 도메인 ttl 에서 선언)
#   (b) 상품종류 클래스 — 그 상품이 ETF 인가 ETN 인가 (fp:ETF / fp:ETN)
# 두 ETF 마스터에는 ETN 이 섞여 있어 (a) 는 (b) 의 하위가 아니다 —
# fp:DomesticETF rdfs:subClassOf fp:ETF 로 두면 ETN 행까지 ETF 로 단정해 disjointWith 와 모순이 된다.
fp:Product a owl:Class ; rdfs:comment "금융상품 공통 상위 클래스 — 제출 규격 p.9 의 fp:Product"@ko .

# 상품종류 — ETF ⊥ ETN
fp:ETF rdfs:subClassOf fp:Product ; rdfs:comment "상장지수펀드 — 운용사가 설정한 펀드"@ko .
fp:ETN rdfs:subClassOf fp:Product ; rdfs:comment "상장지수증권 — 증권사가 발행한 채무증권. 발행사 신용위험이 있고 구성종목 개념이 없다"@ko .
fp:ETF owl:disjointWith fp:ETN .  # 한 상품이 둘 다일 수 없다 — 'ETF' 질의에 ETN 이 섞이면 오답
# 판별자: domestic_etfs.pd_grp_no → ETF 1,235건 · ETN 545건 (실측). fp:ETF 질의는 pd_grp_no='ETF' 필터 필수
# 판별자: overseas_etfs.pd_grp_no → ETF 5,972건 · ETN 65건 (실측). fp:ETF 질의는 pd_grp_no='ETF' 필터 필수

# ── 외부 수집 보조 테이블 (마스터 아님 — Security alias 원천, 상품→종목 관계는 이 테이블이 edge 역할) ──
fp:ExternalHoldings a owl:Class ; rdfs:comment "외부 수집 테이블 ext_etf_holdings, ext_ovs_etf_holdings, ext_fund_holdings (발행일 ≤ 2026-08-24)"@ko .
fp:ExternalFundPage a owl:Class ; rdfs:comment "외부 수집 테이블 ext_fund_page (발행일 ≤ 2026-08-24)"@ko .

# ── 역관계 (규격 작성 팁: inverseOf — '운용사가 상품을 운용한다' ↔ '상품이 운용사에 의해 운용된다') ──
fp:manages a owl:ObjectProperty ; owl:inverseOf fp:hasManager ; rdfs:comment "운용사 → 상품 (fp:hasManager 의 역)"@ko .
fp:issues a owl:ObjectProperty ; owl:inverseOf fp:hasIssuer ; rdfs:comment "발행사 → 상품 (fp:hasIssuer 의 역)"@ko .
fp:isHeldBy a owl:ObjectProperty ; owl:inverseOf fp:holds ; rdfs:comment "종목 → 그 종목을 편입한 상품 (fp:holds 의 역) — '삼성전자 편입 ETF' 질의의 탐색 방향"@ko .

# ── 위험등급 값 제약 (규격 작성 팁: riskGrade 0~6 — 1~5 로 제약하면 실데이터가 차단된다: 6등급 채권 24.6%·0등급 존재) ──
fp:riskGradeValue a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf ( fp:DomesticBond fp:DomesticETF fp:PublicFund ) ] ;  # 해외ETF 는 위험등급 컬럼 자체가 없음(ABSENT — etf_gl.ttl)
    rdfs:range [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                 owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 6 ] ) ] ;
    rdfs:comment "위험등급 정수값 0~6 — 개체 표현은 fp:hasRiskGrade → fp:RiskGrade 노드"@ko .

# ── AssetClass (shared/asset_class.yaml) ──
fp:AssetClass a owl:Class .
fp:hasAssetClass a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( fp:DomesticETF fp:OverseasETF fp:PublicFund ) ] ;
    rdfs:range fp:AssetClass ;
    rdfs:comment "투자자산군 (주식/채권/원자재 등)"@ko .
fp:AssetClass_Equity a fp:AssetClass ; skos:prefLabel "주식"@ko, "Equity"@en .
