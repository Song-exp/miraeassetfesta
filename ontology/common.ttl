# ── RiskGrade (shared/risk_grade.yaml) ──
fp:RiskGrade a owl:Class .
fp:hasRiskGrade a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( fp:DomesticBond fp:DomesticETF fp:PublicFund ) ] ;
    rdfs:range fp:RiskGrade ;
    rdfs:comment "투자위험등급 (1=매우높은위험 ~ 6=매우낮은위험, 낮을수록 위험. 0=미분류) | scale: 0~6 (정수) | direction: 낮을수록 위험 (1=매우높은위험, 6=매우낮은위험)"@ko .
fp:RiskGrade_1 a fp:RiskGrade ; skos:prefLabel "매우 높은 위험"@ko .
fp:RiskGrade_2 a fp:RiskGrade ; skos:prefLabel "높은 위험"@ko .
fp:RiskGrade_3 a fp:RiskGrade ; skos:prefLabel "다소 높은 위험"@ko .
fp:RiskGrade_4 a fp:RiskGrade ; skos:prefLabel "보통 위험"@ko .
fp:RiskGrade_5 a fp:RiskGrade ; skos:prefLabel "낮은 위험"@ko .
fp:RiskGrade_6 a fp:RiskGrade ; skos:prefLabel "매우 낮은 위험"@ko .
fp:RiskGrade_0 a fp:RiskGrade ; skos:prefLabel "미분류"@ko .

# ── Security (shared/security_auto.yaml) ──
fp:Security a owl:Class .
fp:holds a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( fp:ExternalHoldings ) ] ;
    rdfs:range fp:Security ;
