# ── Region (shared/region.yaml) ──
fp:Region a owl:Class .
fp:hasRegion a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( fp:DomesticETF fp:OverseasETF fp:PublicFund ) ] ;
    rdfs:range fp:Region ;
    rdfs:comment "투자지역 (계층: 국가 ⊂ 권역 ⊂ 글로벌)"@ko .
