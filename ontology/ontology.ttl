:Index a owl:Class .
:tracksIndex a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( :DomesticETF :OverseasETF :PublicFund ) ] ;
    rdfs:range :Index ;
    rdfs:comment "기초지수·벤치마크"@ko .
