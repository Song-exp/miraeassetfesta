# ── Region (shared/region.yaml) ──
:Region a owl:Class .
:hasRegion a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( :DomesticETF :OverseasETF :PublicFund ) ] ;
    rdfs:range :Region ;
    rdfs:comment "투자지역 (계층: 국가 ⊂ 권역 ⊂ 글로벌)"@ko .
