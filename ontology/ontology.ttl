# ── CreditGrade (shared/credit_grade.yaml) ──
:CreditGrade a owl:Class .
:hasCreditGrade a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( :DomesticBond ) ] ;
    rdfs:range :CreditGrade ;
    rdfs:comment "신용등급 (AAA 최상위 ~ C, BBB-/BB+ 경계가 투자/투기) | scale: rank 1(AAA) ~ 19(C) | direction: rank 낮을수록 우량"@ko .
