# ── 상품 클래스 계층 ──
:FinancialProduct a owl:Class .
:DomesticBond rdfs:subClassOf :FinancialProduct ; rdfs:comment "SQLite 테이블 domestic_bonds"@ko .
:DomesticETF rdfs:subClassOf :FinancialProduct ; rdfs:comment "SQLite 테이블 domestic_etfs"@ko .
:OverseasETF rdfs:subClassOf :FinancialProduct ; rdfs:comment "SQLite 테이블 overseas_etfs"@ko .
:PublicFund rdfs:subClassOf :FinancialProduct ; rdfs:comment "SQLite 테이블 public_funds"@ko .
# ── 외부 수집 보조 테이블 (마스터 아님 — Security alias 원천, 상품→종목 관계는 이 테이블이 edge 역할) ──
:ExternalHoldings a owl:Class ; rdfs:comment "외부 수집 테이블 ext_etf_holdings, ext_ovs_etf_holdings, ext_fund_holdings (발행일 ≤ 2026-08-24)"@ko .
:ExternalFundPage a owl:Class ; rdfs:comment "외부 수집 테이블 ext_fund_page (발행일 ≤ 2026-08-24)"@ko .
:ETF a owl:Class . :ETN a owl:Class .
:ETF owl:disjointWith :ETN .  # 규칙 §4 — 국내ETF마스터에 ETN 532건 혼입, 구분은 실제 필터

# ── AssetClass (shared/asset_class.yaml) ──
:AssetClass a owl:Class .
:hasAssetClass a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( :DomesticETF :OverseasETF :PublicFund ) ] ;
    rdfs:range :AssetClass ;
    rdfs:comment "투자자산군 (주식/채권/원자재 등)"@ko .
# ABSENT: :DomesticBond 에는 :hasAssetClass 없음 — 자산군 컬럼 없음 — 상품 자체가 채권. 클래스 계층(DomesticBond ⊂ Bond)으로 처리
