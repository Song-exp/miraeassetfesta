:Region_LatinAmerica a :Region ; skos:prefLabel "남미"@ko, "Latin America"@en .
:Region_LatinAmerica skos:broader :Region_Americas .
:Region_US a :Region ; skos:prefLabel "미국"@ko, "United States"@en .
:Region_US skos:broader :Region_NorthAmerica .
:Region_Europe a :Region ; skos:prefLabel "유럽"@ko, "Europe"@en .
:Region_Europe skos:broader :Region_Global .
:Region_Emerging a :Region ; skos:prefLabel "이머징/브릭스"@ko, "Emerging Markets"@en .
:Region_Emerging skos:broader :Region_Global .
:Region_MEA a :Region ; skos:prefLabel "중동/아프리카"@ko, "Middle East & Africa"@en .
:Region_MEA skos:broader :Region_Global .

# ── RiskGrade (shared/risk_grade.yaml) ──
:RiskGrade a owl:Class .
:hasRiskGrade a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( :DomesticBond :DomesticETF :PublicFund ) ] ;
    rdfs:range :RiskGrade ;
    rdfs:comment "투자위험등급 (1=매우높은위험 ~ 6=매우낮은위험, 낮을수록 위험. 0=미분류) | scale: 0~6 (정수) | direction: 낮을수록 위험 (1=매우높은위험, 6=매우낮은위험)"@ko .
# ABSENT: :OverseasETF 에는 :hasRiskGrade 없음 — 위험등급 컬럼 자체 없음 → '위험등급 낮은 해외ETF' 질의는 HCX 호출 0회로 기각
:OverseasETF rdfs:comment "hasRiskGrade 속성 없음: 위험등급 컬럼 자체 없음 → '위험등급 낮은 해외ETF' 질의는 HCX 호출 0회로 기각"@ko .
:RiskGrade_1 a :RiskGrade ; skos:prefLabel "매우 높은 위험"@ko .
:RiskGrade_2 a :RiskGrade ; skos:prefLabel "높은 위험"@ko .
:RiskGrade_3 a :RiskGrade ; skos:prefLabel "다소 높은 위험"@ko .
:RiskGrade_4 a :RiskGrade ; skos:prefLabel "보통 위험"@ko .
:RiskGrade_5 a :RiskGrade ; skos:prefLabel "낮은 위험"@ko .
:RiskGrade_6 a :RiskGrade ; skos:prefLabel "매우 낮은 위험"@ko .
:RiskGrade_6_variant a :RiskGrade ; skos:prefLabel "매우 낮은 위험 (오염 표기)"@ko .
:RiskGrade_0 a :RiskGrade ; skos:prefLabel "미분류"@ko .

