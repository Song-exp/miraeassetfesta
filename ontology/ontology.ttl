# ── Region (shared/region.yaml) ──
:Region a owl:Class .
:hasRegion a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( :DomesticETF :OverseasETF :PublicFund ) ] ;
    rdfs:range :Region ;
    rdfs:comment "투자지역 (계층: 국가 ⊂ 권역 ⊂ 글로벌)"@ko .
# ABSENT: :DomesticBond 에는 :hasRegion 없음 — 투자지역 컬럼 없음 — PD_CTRY_CD(발행국)는 42,393/42,394가 KR 인 사실상 상수 (enums 판정: kg_entity null)
:DomesticBond rdfs:comment "hasRegion 속성 없음: 투자지역 컬럼 없음 — PD_CTRY_CD(발행국)는 42,393/42,394가 KR 인 사실상 상수 (enums 판정: kg_entity null)"@ko .
:Region_Global a :Region ; skos:prefLabel "글로벌"@ko, "Global"@en .
:Region_GlobalExUS a :Region ; skos:prefLabel "글로벌(미국 제외)"@ko, "Global Ex US"@en .
:Region_GlobalExUS skos:broader :Region_Global .
:Region_Asia a :Region ; skos:prefLabel "아시아"@ko, "Asia"@en .
:Region_Asia skos:broader :Region_Global .
:Region_Korea a :Region ; skos:prefLabel "국내"@ko, "Korea"@en .
:Region_Korea skos:broader :Region_Asia .
:Region_China a :Region ; skos:prefLabel "중국"@ko, "China"@en .
:Region_China skos:broader :Region_Asia .
:Region_Japan a :Region ; skos:prefLabel "일본"@ko, "Japan"@en .
:Region_Japan skos:broader :Region_Asia .
:Region_India a :Region ; skos:prefLabel "인도"@ko, "India"@en .
:Region_India skos:broader :Region_Asia .
:Region_Vietnam a :Region ; skos:prefLabel "베트남"@ko, "Vietnam"@en .
:Region_Vietnam skos:broader :Region_Asia .
:Region_Americas a :Region ; skos:prefLabel "남미/북미"@ko, "Americas"@en .
:Region_Americas skos:broader :Region_Global .
:Region_NorthAmerica a :Region ; skos:prefLabel "북미"@ko, "North America"@en .
:Region_NorthAmerica skos:broader :Region_Americas .
:Region_LatinAmerica a :Region ; skos:prefLabel "남미"@ko, "Latin America"@en .
:Region_LatinAmerica skos:broader :Region_Americas .
:Region_US a :Region ; skos:prefLabel "미국"@ko, "United States"@en .
:Region_US skos:broader :Region_NorthAmerica .
:Region_Europe a :Region ; skos:prefLabel "유럽"@ko, "Europe"@en .
:Region_Europe skos:broader :Region_Global .
:Region_Emerging a :Region ; skos:prefLabel "이머징/브릭스"@ko, "Emerging Markets"@en .
:Region_Emerging skos:broader :Region_Global .
:Region_MEA a :Region ; skos:prefLabel "중동/아프리카"@ko, "Middle East & Africa"@en .
:Region_MEA skos:broader :Region_Global .

# ── RiskGrade (shared/risk_grade.yaml) ──
:RiskGrade a owl:Class .
:hasRiskGrade a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( :DomesticBond :DomesticETF :PublicFund ) ] ;
    rdfs:range :RiskGrade ;
    rdfs:comment "투자위험등급 (1=매우높은위험 ~ 6=매우낮은위험, 낮을수록 위험. 0=미분류) | scale: 0~6 (정수) | direction: 낮을수록 위험 (1=매우높은위험, 6=매우낮은위험)"@ko .
# ABSENT: :OverseasETF 에는 :hasRiskGrade 없음 — 위험등급 컬럼 자체 없음 → '위험등급 낮은 해외ETF' 질의는 HCX 호출 0회로 기각
:OverseasETF rdfs:comment "hasRiskGrade 속성 없음: 위험등급 컬럼 자체 없음 → '위험등급 낮은 해외ETF' 질의는 HCX 호출 0회로 기각"@ko .
:RiskGrade_1 a :RiskGrade ; skos:prefLabel "매우 높은 위험"@ko .
:RiskGrade_2 a :RiskGrade ; skos:prefLabel "높은 위험"@ko .
:RiskGrade_3 a :RiskGrade ; skos:prefLabel "다소 높은 위험"@ko .
:RiskGrade_4 a :RiskGrade ; skos:prefLabel "보통 위험"@ko .
:RiskGrade_5 a :RiskGrade ; skos:prefLabel "낮은 위험"@ko .
:RiskGrade_6 a :RiskGrade ; skos:prefLabel "매우 낮은 위험"@ko .
:RiskGrade_0 a :RiskGrade ; skos:prefLabel "미분류"@ko .

